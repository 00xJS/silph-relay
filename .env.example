# Copy to .env and fill in — .env is gitignored, never commit real values
RSSHUB_URL=https://your-username-silph-rsshub.hf.space

# Must match the ACCESS_KEY secret set on the RSSHub Space (blocks strangers
# from using the public Space)
RSSHUB_ACCESS_KEY=

# Pokémon GO channel (@PokemonGoApp, @LeekDuck, @thepokemodgroup)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# TCG restocks & deals channel (@pokemonrestocks, @PokemonDealsTCG)
DISCORD_WEBHOOK_URL_RESTOCKS=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# Optional: max posts relayed per account per run (default 5)
# MAX_NEW_POSTS_PER_RUN=5

# Optional: entries requested per feed (default 5; keeps responses small)
# FEED_LIMIT=5
