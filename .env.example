# Copy to .env and fill in — .env is gitignored, never commit real values.
# Only needed to run the relay on your own machine: python3 src/main.py

# Pokémon GO channel (@PokemonGoApp, @LeekDuck, @thepokemodgroup, @ScopelyExplore)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# TCG restocks & deals channel (@pokemonrestocks, @PokemonDealsTCG)
DISCORD_WEBHOOK_URL_RESTOCKS=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# Everything below is optional. In GitHub Actions these are repo *variables*
# (Settings -> Secrets and variables -> Actions -> Variables), except
# HEALTHCHECK_URL, which is a secret.

# Post sources — FxTwitter first, then each Nitter instance in order
# FEED_SOURCE=auto                  # auto | fx | nitter
# NITTER_BASE=https://nitter.meowing.monster,https://shitter.thepixora.com

# Fast polling for the restock accounts: extra polls inside one run
# POLL_CYCLES=3                     # 1 = poll once per run
# POLL_MODE=clock                   # clock (spread across the minute) | window (the original timing)
# POLL_WINDOW_SECONDS=35            # window mode only

# Discord
# DISCORD_ACCOUNT_IDENTITY=1        # 0 = post under the webhook's own name/avatar
# DISCORD_RESTOCK_ROLE_ID=          # role to ping on fresh restock posts
# LATE_POST_SECONDS=600             # stamp "posted N ago" on posts later than this

# Limits
# MAX_NEW_POSTS_PER_RUN=5           # per account per run; older overflow is marked seen
# MAX_POST_AGE_HOURS=24             # never relay posts older than this

# Heartbeat monitor (healthchecks.io ping URL)
# HEALTHCHECK_URL=
